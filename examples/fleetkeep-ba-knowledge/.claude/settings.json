{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "mcp__atlassian__create*",
      "mcp__atlassian__edit*",
      "mcp__atlassian__transition*",
      "mcp__atlassian__addOrEdit*",
      "mcp__atlassian__add*",
      "mcp__atlassian__update*",
      "mcp__atlassian__manage*",
      "mcp__atlassian__watch*",
      "mcp__atlassian__unwatch*",
      "mcp__atlassian__upload*",
      "mcp__atlassian__convert*",
      "mcp__atlassian__move*",
      "mcp__atlassian__archive*",
      "mcp__atlassian__unarchive*",
      "mcp__atlassian__restore*",
      "mcp__atlassian__set*",
      "mcp__atlassian__copy*",
      "mcp__atlassian__replace*",
      "mcp__atlassian__remove*",
      "mcp__atlassian__enable*",
      "mcp__atlassian__disable*",
      "mcp__atlassian__complete*",
      "mcp__atlassian__reopen*",
      "mcp__atlassian__star*",
      "mcp__atlassian__unstar*",
      "mcp__atlassian__publish*",
      "mcp__atlassian__share*",
      "mcp__atlassian__recover*",
      "mcp__atlassian__approve*",
      "mcp__atlassian__requestChanges*",
      "mcp__atlassian__merge*",
      "mcp__atlassian__run*",
      "mcp__atlassian__resolveBitbucket*",
      "mcp__atlassian__executeWrite",
      "Bash(git push *)",
      "Bash(git * push *)",
      "Bash(git checkout *)",
      "Bash(git restore *)",
      "Bash(git rebase *)",
      "Bash(git stash drop *)",
      "PowerShell(git push *)",
      "PowerShell(git * push *)",
      "PowerShell(git checkout *)",
      "PowerShell(git restore *)",
      "PowerShell(git rebase *)",
      "PowerShell(git stash drop *)"
    ],
    "deny": [
      "mcp__atlassian__delete*",
      "mcp__atlassian__executeDestructive",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git filter-branch *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f *)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git reset * --hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git filter-branch *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/kb-sync.sh\""
          }
        ]
      }
    ]
  }
}
