{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v2/mcp",
      "enabled": true
    }
  },
  "permission": {
    "edit": {
      "*": "allow",
      "*.opencode/*": "ask",
      "*.claude/*": "ask",
      "*.codex/*": "ask",
      "*.agents/*": "ask",
      "*.opencode\\*": "ask",
      "*.claude\\*": "ask",
      "*.codex\\*": "ask",
      "*.agents\\*": "ask",
      "*opencode.json": "ask",
      "*.mcp.json": "ask"
    },
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git status *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git fetch": "allow",
      "git fetch *": "allow",
      "git pull --ff-only": "allow",
      "git pull --ff-only *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git rm knowledge/_staging/*": "allow",
      "git rm -f knowledge/_staging/*": "allow",
      "git checkout -b kb/stage-*": "allow",
      "git remote -v": "allow",
      "git rev-parse *": "allow",
      "git apply --check *": "allow",
      "python tools/kb.py *": "allow",
      "python3 tools/kb.py *": "allow",
      "bash tools/kb-sync.sh": "allow",
      "markitdown *": "allow",
      "mkdir *": "allow",
      "rm knowledge/_staging/*": "allow",
      "rm *..*": "ask",
      "git rm *..*": "ask",
      "git push": "ask",
      "git push *": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push * --force*": "deny",
      "git push * -f *": "deny",
      "git push * -f": "deny",
      "git reset --hard*": "deny",
      "git reset * --hard*": "deny",
      "git clean *": "deny",
      "git branch -D *": "deny",
      "git filter-branch *": "deny"
    },
    "skill": {
      "setup": "deny",
      "kb-seed": "deny",
      "intake": "deny",
      "sync": "deny",
      "requirements": "deny",
      "review": "deny",
      "backlog": "deny",
      "ask": "deny",
      "improve-harness": "deny"
    },
    "atlassian_*": "ask",
    "atlassian_getAccessibleAtlassianResources": "allow",
    "atlassian_atlassianUserInfo": "allow",
    "atlassian_searchJiraIssuesUsingJql": "allow",
    "atlassian_getJiraIssue": "allow",
    "atlassian_getJiraIssueTypeMetaWithFields": "allow",
    "atlassian_listJiraIssueComments": "allow",
    "atlassian_listJiraIssueChangelogs": "allow",
    "atlassian_lookupJiraAccountId": "allow",
    "atlassian_searchConfluence": "allow",
    "atlassian_getConfluenceContent": "allow",
    "atlassian_search": "allow",
    "atlassian_discover": "allow",
    "atlassian_executeRead": "allow",
    "atlassian_delete*": "deny",
    "atlassian_executeDestructive": "deny"
  }
}
