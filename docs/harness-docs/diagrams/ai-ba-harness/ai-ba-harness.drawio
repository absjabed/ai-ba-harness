<mxfile host="Electron" agent="ai-ba-harness-docs" version="24.7.17"><diagram id="page1" name="1 Architecture"><mxGraphModel dx="1640" dy="940" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="940" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1c1" value="Architecture: one set of definitions, wired into three assistants" style="text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="40" as="geometry"/></mxCell><mxCell id="p1c2" value="Read top to bottom. You work in &lt;b&gt;Claude Code, OpenCode or Codex&lt;/b&gt;; each has its own thin wiring, which points at the same &lt;b&gt;command definitions&lt;/b&gt;. The definitions read and change the &lt;b&gt;project knowledge&lt;/b&gt; and run the &lt;b&gt;tools&lt;/b&gt;. Grey boxes sit outside the harness." style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1560" height="40" as="geometry"/></mxCell><mxCell id="p1c3" value="&lt;b&gt;BA or teammate&lt;/b&gt;&lt;br&gt;types a command or asks a question" style="rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="320" height="56" as="geometry"/></mxCell><mxCell id="p1c4" value="&lt;b&gt;Assistant session&lt;/b&gt;&lt;br&gt;Claude Code · OpenCode · Codex, opened in the BA repository" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="420" y="120" width="560" height="56" as="geometry"/></mxCell><mxCell id="p1c5" value="types" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1c3" target="p1c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1c6" value="&lt;b&gt;Client wiring&lt;/b&gt;: one set per assistant" style="rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fillColor=#f0f6fc;strokeColor=#6c8ebf;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="430" height="470" as="geometry"/></mxCell><mxCell id="p1c7" value="&lt;b&gt;Claude Code&lt;/b&gt;&lt;br&gt;.claude/commands/ (9 commands)&lt;br&gt;.claude/agents/critic.md&lt;br&gt;.claude/settings.json: asks, refusals, sync hook&lt;br&gt;.mcp.json · CLAUDE.md" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="390" height="120" as="geometry"/></mxCell><mxCell id="p1c8" value="&lt;b&gt;OpenCode&lt;/b&gt;&lt;br&gt;.opencode/commands/ (9 commands)&lt;br&gt;.opencode/agents/: critic.md, kb-reader.md&lt;br&gt;opencode.json: Atlassian server, permission rules&lt;br&gt;AGENTS.md" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="390" height="120" as="geometry"/></mxCell><mxCell id="p1c9" value="&lt;b&gt;Codex&lt;/b&gt;&lt;br&gt;.agents/skills/ (9 skills)&lt;br&gt;.codex/config.toml · .codex/rules/&lt;br&gt;.codex/hooks.json · .codex/agents/critic.toml&lt;br&gt;AGENTS.md" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="390" height="120" as="geometry"/></mxCell><mxCell id="p1c10" value="&lt;b&gt;Command definitions&lt;/b&gt;" style="rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fillColor=#f3f9f1;strokeColor=#82b366;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="480" y="230" width="360" height="470" as="geometry"/></mxCell><mxCell id="p1c11" value="&lt;b&gt;agents/&amp;lt;command&amp;gt;.md&lt;/b&gt;&lt;br&gt;9 commands, plain Markdown:&lt;br&gt;setup · kb-seed · intake · sync ·&lt;br&gt;requirements · review · backlog ·&lt;br&gt;ask · improve-harness" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="500" y="280" width="320" height="120" as="geometry"/></mxCell><mxCell id="p1c12" value="&lt;b&gt;agents/_knowledge-pipeline.md&lt;/b&gt;&lt;br&gt;prepare → extract → judge →&lt;br&gt;stage → critique → confirm → apply" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="500" y="420" width="320" height="76" as="geometry"/></mxCell><mxCell id="p1c13" value="&lt;b&gt;agents/_critic.md&lt;/b&gt;&lt;br&gt;the read-only second look at&lt;br&gt;each staging file" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="500" y="516" width="320" height="76" as="geometry"/></mxCell><mxCell id="p1c14" value="&lt;b&gt;agents/README.md&lt;/b&gt;&lt;br&gt;wrappers per assistant, safety layers" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="500" y="612" width="320" height="64" as="geometry"/></mxCell><mxCell id="p1c15" value="&lt;b&gt;Project knowledge&lt;/b&gt;" style="rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fillColor=#f3f9f1;strokeColor=#82b366;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="870" y="230" width="430" height="470" as="geometry"/></mxCell><mxCell id="p1c16" value="&lt;b&gt;knowledge/&lt;/b&gt;&lt;br&gt;pages (CAP · PROC · ENT · DEC · Q) · glossary ·&lt;br&gt;stakeholders · raid · log · registers ·&lt;br&gt;_staging/ · sources/ · _meta/conventions.md" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="890" y="280" width="390" height="92" as="geometry"/></mxCell><mxCell id="p1c17" value="&lt;b&gt;requirements/&amp;lt;slug&amp;gt;/&lt;/b&gt;&lt;br&gt;requirement.md · review.md" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="890" y="388" width="390" height="56" as="geometry"/></mxCell><mxCell id="p1c18" value="&lt;b&gt;trace/map.csv&lt;/b&gt;&lt;br&gt;requirement → story → Jira key → pages" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="890" y="460" width="390" height="56" as="geometry"/></mxCell><mxCell id="p1c19" value="&lt;b&gt;PROJECT-PROFILE.md&lt;/b&gt;&lt;b