&gt;.github/workflows/&lt;/b&gt;&lt;br&gt;kb-check.yml: check on&lt;br&gt;every push" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1350" y="432" width="250" height="72" as="geometry"/></mxCell><mxCell id="p1c25" value="runs" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1c4" target="p1c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1c26" value="points to" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1c6" target="p1c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1c27" value="reads · stages · applies" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p1c10" target="p1c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1c28" value="runs" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1c10" target="p1c21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="210"/><mxPoint x="1475" y="210"/></Array></mxGeometry></mxCell><mxCell id="p1c29" value="&lt;b&gt;Outside the harness&lt;/b&gt;" style="rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fillColor=#f7f7f7;strokeColor=#bbbbbb;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="740" width="1600" height="150" as="geometry"/></mxCell><mxCell id="p1c30" value="&lt;b&gt;Jira and Confluence&lt;/b&gt;&lt;br&gt;through the Atlassian MCP server,&lt;br&gt;your own OAuth sign-in" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="290" height="76" as="geometry"/></mxCell><mxCell id="p1c31" value="&lt;b&gt;inbox/&lt;/b&gt;&lt;br&gt;raw notes and documents,&lt;br&gt;never committed" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="360" y="790" width="290" height="76" as="geometry"/></mxCell><mxCell id="p1c32" value="&lt;b&gt;Git remote&lt;/b&gt;&lt;br&gt;the shared copy the team&lt;br&gt;clones and pulls" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="680" y="790" width="290" height="76" as="geometry"/></mxCell><mxCell id="p1c33" value="&lt;b&gt;Obsidian&lt;/b&gt; (optional)&lt;br&gt;knowledge/ opens as a vault" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1000" y="790" width="290" height="76" as="geometry"/></mxCell><mxCell id="p1c34" value="&lt;b&gt;AI BA Harness template&lt;/b&gt;&lt;br&gt;new-project.sh, HARNESS_VERSION,&lt;br&gt;handbook" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1320" y="790" width="280" height="76" as="geometry"/></mxCell><mxCell id="p1c35" value="MCP tools" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1c6" target="p1c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1c36" value="reads raw material" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1c10" target="p1c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1c37" value="fetch · fast-forward" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1c21" target="p1c32"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1417" y="720"/><mxPoint x="883" y="720"/></Array></mxGeometry></mxCell><mxCell id="p1c38" value="&lt;i&gt;Legend:&lt;/i&gt; yellow = person · blue = wiring and tools the assistant runs · green = definitions and knowledge (Markdown) · grey = outside the harness · dashed = data" style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="1560" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="2 Agent pattern"><mxGraphModel dx="1700" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="820" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2c1" value="Agent pattern: one definition, three wrappers, read-only sub-agents" style="text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="40" as="geometry"/></mxCell><mxCell id="p2c2" value="One row per command. Each assistant has a &lt;b&gt;thin wrapper&lt;/b&gt; that names the command and its permissions, then points to the &lt;b&gt;definition&lt;/b&gt; in agents/, where all the instructions live. Read-only &lt;b&gt;sub-agents&lt;/b&gt; give a second look in a fresh context." style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1620" height="40" as="geometry"/></mxCell><mxCell id="p2c3" value="&lt;b&gt;Wrappers&lt;/b&gt;: each points to the definition in its row" style="rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fillColor=#f0f6fc;strokeColor=#6c8ebf;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="104" width="590" height="600" as="geometry"/></mxCell><mxCell id="p2c4" value="Claude Code&lt;br&gt;&lt;font style='font-size:11px'&gt;.claude/commands/&lt;/font&gt;" style="text;fontSize=14;fontStyle=1;fontColor=#333333;align=center;verticalAlign=middle;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="170" height="44" as="geometry"/></mxCell><mxCell id="p2c5" value="OpenCode&lt;br&gt;&lt;font style='font-size:11px'&gt;.opencode/commands/&lt;/font&gt;" style="text;fontSize=14;fontStyle=1;fontColor=#333333;align=center;verticalAlign=middle;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="230" y="140" width="170" height="44" as="geometry"/></mxCell><mxCell id="p2c6" value="Codex&lt;br&gt;&lt;font style='font-size:11px'&gt;.agents/skills/&amp;lt;name&amp;gt;/&lt;/font&gt;" style="text;fontSize=14;fontStyle=1;fontColor=#333333;align=center;verticalAlign=middle;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="420" y="140" width="170" height="44" as="geometry"/></mxCell><mxCell id="p2c7" value="Definition&lt;br&gt;&lt;font style='font-size:11px'&gt;agents/&lt;/font&gt;" style="text;fontSize=14;fontStyle=1;fontColor=#333333;align=center;verticalAlign=middle;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="650" y="140" width="250" height="44" as="geometry"/></mxCell><mxCell id="p2c8" value="Sub-agent&lt;br&gt;&lt;font style='font-size:11px'&gt;read-only, fresh context&lt;/font&gt;" style="text;fontSize=14;fontStyle=1;fontColor=#333333;align=center;verticalAlign=middle;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="950" y="140" width="210" height="44" as="geometry"/></mxCell><mxCell id="p2c9" value="/setup" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="196" width="170" height="42" as="geometry"/></mxCell><mxCell id="p2c10" value="/setup" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="230" y="196" width="170" height="42" as="geometry"/></mxCell><mxCell id="p2c11" value="$setup" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="420" y="196" width="170" height="42" as="geometry"/></mxCell><mxCell id="p2c12" value="&lt;b&gt;agents/setup.md&lt;/b&gt;" style="rounded=1;ar