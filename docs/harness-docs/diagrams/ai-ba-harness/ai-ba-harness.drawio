cSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="420" y="520" width="170" height="42" as="geometry"/></mxCell><mxCell id="p2c50" value="&lt;b&gt;agents/backlog.md&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="650" y="520" width="250" height="42" as="geometry"/></mxCell><mxCell id="p2c51" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2c49" target="p2c50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2c52" value="/ask" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="574" width="170" height="42" as="geometry"/></mxCell><mxCell id="p2c53" value="/ask" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="230" y="574" width="170" height="42" as="geometry"/></mxCell><mxCell id="p2c54" value="$ask" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="420" y="574" width="170" height="42" as="geometry"/></mxCell><mxCell id="p2c55" value="&lt;b&gt;agents/ask.md&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="650" y="574" width="250" height="42" as="geometry"/></mxCell><mxCell id="p2c56" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2c54" target="p2c55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2c57" value="kb-reader (OpenCode)" style="rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="950" y="574" width="210" height="42" as="geometry"/></mxCell><mxCell id="p2c58" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="p2c55" target="p2c57"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2c59" value="/improve-harness" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="628" width="170" height="42" as="geometry"/></mxCell><mxCell id="p2c60" value="/improve-harness" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="230" y="628" width="170" height="42" as="geometry"/></mxCell><mxCell id="p2c61" value="$improve-harness" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="420" y="628" width="170" height="42" as="geometry"/></mxCell><mxCell id="p2c62" value="&lt;b&gt;agents/improve-harness.md&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="650" y="628" width="250" height="42" as="geometry"/></mxCell><mxCell id="p2c63" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2c61" target="p2c62"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2c64" value="&lt;b&gt;Shared steps&lt;/b&gt;&lt;br&gt;agents/_knowledge-pipeline.md: used by&lt;br&gt;/kb-seed, /intake, /sync and /requirements&lt;br&gt;agents/_critic.md: what the critic checks" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1200" y="196" width="460" height="92" as="geometry"/></mxCell><mxCell id="p2c65" value="&lt;b&gt;What a wrapper holds&lt;/b&gt;&lt;br&gt;The command's name, description and what it may&lt;br&gt;run without asking. No instructions of its own, so&lt;br&gt;it can never drift from the definition. kb.py check&lt;br&gt;fails when a wrapper is missing or points elsewhere." style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1200" y="308" width="460" height="110" as="geometry"/></mxCell><mxCell id="p2c66" value="&lt;b&gt;The sub-agents&lt;/b&gt;&lt;br&gt;critic: .claude/agents/critic.md (Read, Grep, Glob),&lt;br&gt;.opencode/agents/critic.md, .codex/agents/critic.toml&lt;br&gt;(read-only sandbox). kb-reader runs /ask in OpenCode&lt;br&gt;with no edit, shell or Jira write tools." style="rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1200" y="438" width="460" height="110" as="geometry"/></mxCell><mxCell id="p2c67" value="&lt;b&gt;How each assistant limits a command&lt;/b&gt;&lt;br&gt;Claude Code: allowed-tools and disallowed-tools.&lt;br&gt;OpenCode: opencode.json rules; /ask's agent field.&lt;br&gt;Codex: every skill but ask runs only when named&lt;br&gt;(agents/openai.yaml). Others: AGENTS.md." style="rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1200" y="568" width="460" height="110" as="geometry"/></mxCell><mxCell id="p2c68" value="&lt;i&gt;Legend:&lt;/i&gt; blue = wrapper (what you type) · green = definition, the only place with instructions · purple = read-only sub-agent · solid arrow = points to · dashed = spawns" style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="1620" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page3" name="3 BA lifecycle"><mxGraphModel dx="1880" dy="1030" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1030" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3c1" value="BA lifecycle: from a Jira issue or new material to the Jira backlog" style="text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="40" as="geometry"/></mxCell><mxCell id="p3c2" value="Read left to right, once per piece of work. It starts from a &lt;b&gt;Jira issue&lt;/b&gt; or material in &lt;b&gt;inbox/&lt;/b&gt; and ends with what the BA hands on: &lt;b&gt;requirements, Jira issues and the trace&lt;/b&gt;. Each stage reads what the stages before it wrote. Setting up a project happens once and is not shown." style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1800" height="40" as="geometry"/></mxCell><mxCell id="p3c3" value="&lt;b&gt;Stage&lt;/b&gt;" style="rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fillColor=#f7f7f7;strokeColor=#bbbbbb;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="1840" height="170" as="geometry"/></mxCell><mxCell id="p3c4" value="&lt;b&gt;Jira issue or inbox material&lt;/b&gt;&lt;br&gt;a Jira key, or notes, a&lt;br&gt;transcript or a document&lt;br&gt;in inbox/" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="230" height="110" as="geometry"/></mxCell><mxCell id="p3c5" value="&lt;b&gt;/intake · /sync&lt;/b&gt;&lt;br&gt;stage → critic →&lt;br&gt;you accept each item&lt;br&gt;→ apply, commit" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="300" y="150" width="230" height="110" as="geometry"/></mxCell><mxCell id="p3c6" value="&lt;b&gt;/requirements&lt;/b&gt;&lt;br&gt;interviews you: questions&lt;br&gt;→ draft → rule-based&lt;br&gt;pre-check" style="rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="230" height="110" as="geometry"/></mxCell><mxCell id="p3c7" value="&lt;b&gt;/review&lt;/b&gt;&lt;br&gt;rule-based and judgement&lt;br&gt;checks → verdict:&lt;br&gt;ready or not ready" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="820" y="150" width="230" height="110" as="geometry"/></mxCell><mxCell id="p3c8" value="&lt;b&gt;Owner sign-off&lt;/b&gt;&lt;br&gt;the owner approves the&lt;br&gt;document; the BA records&lt;br&gt;it with /intake" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1080" y="150" width="230" height="110" as="geometry"/></mxCell><mxCell id="p3c9" value="&lt;b&gt;/backlog&lt;/b&gt;&lt;br&gt;duplicate search →&lt;br&gt;preview → your yes →&lt;br&gt;create → read back" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1340" y="150" width="230" height="110" as="geometry"/></mxCell><mxCell id="p3c10" value="&lt;b&gt;Delivery takes the keys&lt;/b&gt;&lt;br&gt;the AI Dev and QA&lt;br&gt;Harnesses or the team&lt;br&gt;start from the stories" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1600" y="150" width="230" height="110" as="geometry"/></mxCell><mxCell id="p3c11" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3c4" target="p3c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3c12" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3c5" target="p3c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3c13" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3c6" target="p3c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3c14" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3c7" target="p3c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3c15" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3c8" target="p3c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3c16" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3c9" target="p3c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3c17" value="&lt;b&gt;Files each stage writes&lt;/b&gt;" style="rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fillColor=#fffaf2;strokeColor=#e3c48f;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="310" width="1840" height="330" as="geometry"/></mxCell><mxCell id="p3c18" value="knowledge/_staging/&lt;br&gt;&amp;lt;date&amp;gt;-&amp;lt;command&amp;gt;-&amp;lt;slug&amp;gt;.md" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="315" y="350" width="200" height="44" as="geometry"/></mxCell><mxCell id="p3c19" value="knowledge pages&lt;br&gt;(CAP · PROC · ENT · DEC · Q)" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="315" y="410" width="200" height="44" as="geometry"/></mxCell><mxCell id="p3c20" value="sources/SRC-&amp;lt;n&amp;gt;-&amp;lt;date&amp;gt;-&amp;lt;slug&amp;gt;.md" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="315" y="470" width="200" height="36" as="geometry"/></mxCell><mxCell id="p3c21" value="log.md · raid.md · glossary.md" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="315" y="522" width="200" height="36" as="geometry"/></mxCell><mxCell id="p3c22" value="_meta/sync.json &lt;i&gt;(/sync only)&lt;/i&gt;" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="315" y="574" width="200" height="36" as="geometry"/></mxCell><mxCell id="p3c23" value="requirements/&amp;lt;slug&amp;gt;/&lt;br&gt;requirement.md &lt;i&gt;(draft)&lt;/i&gt;" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="575" y="350" width="200" height="44" as="geometry"/></mxCell><mxCell id="p3c24" value="staging file for new terms,&lt;br&gt;rules and questions" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="575" y="410" width="200" height="44" as="geometry"/></mxCell><mxCell id="p3c25" value="requirements/&amp;lt;slug&amp;gt;/&lt;br&gt;review.md &lt;i&gt;(verdict)&lt;/i&gt;" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="835" y="350" width="200" height="44" as="geometry"/></mxCell><mxCell id="p3c26" value="Jira epic and stories" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1355" y="350" width="200" height="36" as="geometry"/></mxCell><mxCell id="p3c27" value="keys in requirement.md&lt;br&gt;(jira_epic, story table)" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1355" y="402" width="200" height="44" as="geometry"/></mxCell><mxCell id="p3c28" value="trace/map.csv rows" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1355" y="462" width="200" height="36" as="geometry"/></mxCell><mxCell id="p3c29" value="log.md line" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1355" y="514" width="200" height="36" as="geometry"/></mxCell><mxCell id="p3c30" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="p3c5" target="p3c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3c31" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="p3c6" target="p3c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3c32" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="p3c7" target="p3c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3c33" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="p3c9" target="p3c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3c34" value="IDs cited" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3c19" target="p3c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3c35" value="ready stories only" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3c25" target="p3c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3c36" value="&lt;b&gt;Other entry points&lt;/b&gt;" style="rounded=1;arcSize=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fillColor=#f0f6fc;strokeColor=#6c8ebf;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="670" width="1840" height="270" as="geometry"/></mxCell><mxCell id="p3c37" value="&lt;b&gt;/ask &amp;lt;question&amp;gt;&lt;/b&gt;&lt;br&gt;anyone; answers only from the&lt;br&gt;knowledge base, cites every claim;&lt;br&gt;read-only in every assistant" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="340" height="104" as="geometry"/></mxCell><mxCell id="p3c38" value="&lt;b&gt;/backlog task · spike · bug&lt;/b&gt;&lt;br&gt;one Jira issue from an ACT- action,&lt;br&gt;a Q- question or a UAT finding,&lt;br&gt;after a preview and your yes" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="400" y="720" width="340" height="104" as="geometry"/></mxCell><mxCell id="p3c39" value="&lt;b&gt;/review &amp;lt;Jira key&amp;gt; · /review kb&lt;/b&gt;&lt;br&gt;an issue's quality, in the chat;&lt;br&gt;the knowledge base's health and&lt;br&gt;questions to chase, weekly" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="760" y="720" width="340" height="104" as="geometry"/></mxCell><mxCell id="p3c40" value="&lt;b&gt;A teammate's /intake&lt;/b&gt;&lt;br&gt;proposes only: the staging file&lt;br&gt;goes to the BA, or on a&lt;br&gt;kb/stage-&amp;lt;slug&amp;gt; branch for a PR" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1120" y="720" width="340" height="104" as="geometry"/></mxCell><mxCell id="p3c41" value="&lt;b&gt;/improve-harness&lt;/b&gt;&lt;br&gt;a project setting in the profile,&lt;br&gt;or a proposal for the harness&lt;br&gt;maintainers in harness-feedback/" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1480" y="720" width="340" height="104" as="geometry"/></mxCell><mxCell id="p3c42" value="&lt;b&gt;Utilities (any time)&lt;/b&gt;&lt;br&gt;tools/kb.py rebuild · check · next · tools/kb-sync.sh (at session start; with each OpenCode command) · the Knowledge base check on every push (.github/workflows/kb-check.yml)" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="1800" height="64" as="geometry"/></mxCell><mxCell id="p3c43" value="&lt;i&gt;Legend:&lt;/i&gt; yellow = interviews you · blue = harness step · grey = outside the harness · orange = file written · dashed = hand-off" style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="1800" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page4" name="4 Knowledge pipeline"><mxGraphModel dx="1600" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p4c1" value="Knowledge pipeline: how anything gets into knowledge/" style="text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="40" as="geometry"/></mxCell><mxCell id="p4c2" value="Shared by &lt;b&gt;/kb-seed, /intake, /sync and /requirements&lt;/b&gt;. Read down the spine. Nothing reaches a knowledge page until the BA has &lt;b&gt;accepted the item&lt;/b&gt;; a teammate's run stops at a proposal." style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1520" height="40" as="geometry"/></mxCell><mxCell id="p4c3" value="/kb-seed · /intake · /sync · /requirements" style="rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="420" y="120" width="400" height="44" as="geometry"/></mxCell><mxCell id="p4c4" value="&lt;b&gt;0 · Prepare&lt;/b&gt;&lt;br&gt;who is running this? · git pull --ff-only ·&lt;br&gt;read the index, glossary, stakeholders, RAID&lt;br&gt;and the registers" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="420" y="190" width="400" height="90" as="geometry"/></mxCell><mxCell id="p4c5" value="&lt;b&gt;Pull clean?&lt;/b&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="530" y="305" width="180" height="90" as="geometry"/></mxCell><mxCell id="p4c6" value="&lt;b&gt;STOP: local changes or&lt;/b&gt;&lt;br&gt;&lt;b&gt;diverged history&lt;/b&gt;; say what to run" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="300" height="64" as="geometry"/></mxCell><mxCell id="p4c7" value="&lt;b&gt;1 · Extract&lt;/b&gt;&lt;br&gt;each item with a quote and its location: requirement ·&lt;br&gt;rule · decision · action · approval · question ·&lt;br&gt;answer · term · risk · fact" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="420" y="420" width="400" height="90" as="geometry"/></mxCell><mxCell id="p4c8" value="&lt;b&gt;2 · Judge&lt;/b&gt;: four verdicts per item&lt;br&gt;against the knowledge base · clarity ·&lt;br&gt;authority (stakeholders.md) · sensitivity" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="420" y="530" width="400" height="76" as="geometry"/></mxCell><mxCell id="p4c9" value="&lt;b&gt;3 · Stage&lt;/b&gt;&lt;br&gt;one staging file: the exact change per item, delivery&lt;br&gt;impact, a play-back for meetings; over 40 items,&lt;br&gt;several files" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="420" y="626" width="400" height="90" as="geometry"/></mxCell><mxCell id="p4c10" value="&lt;b&gt;4 · Critique&lt;/b&gt;&lt;br&gt;the critic sub-agent re-reads the source:&lt;br&gt;fix findings corrected, check findings noted" style="rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="420" y="736" width="400" height="76" as="geometry"/></mxCell><mxCell id="p4c11" value="&lt;b&gt;Maintainer?&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;profile section 1&lt;/font&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="530" y="836" width="180" height="96" as="geometry"/></mxCell><mxCell id="p4c12" value="&lt;b&gt;Teammate route&lt;/b&gt;&lt;br&gt;explain the proposal in plain words ·&lt;br&gt;send the file to the BA, or commit it on&lt;br&gt;kb/stage-&amp;lt;slug&amp;gt;, ask, push, pull request" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="880" y="846" width="360" height="90" as="geometry"/></mxCell><mxCell id="p4c13" value="&lt;b&gt;5 · STOP: the BA accepts, edits or&lt;/b&gt;&lt;br&gt;&lt;b&gt;rejects each item&lt;/b&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="420" y="960" width="400" height="64" as="geometry"/></mxCell><mxCell id="p4c14" value="&lt;b&gt;6 · Apply&lt;/b&gt;&lt;br&gt;pull again · real IDs (kb.py next) · write the accepted&lt;br&gt;items · source record · rebuild the registers · log.md ·&lt;br&gt;remove the staging file · kb.py check" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="420" y="1048" width="400" height="90" as="geometry"/></mxCell><mxCell id="p4c15" value="&lt;b&gt;Commit&lt;/b&gt;: kb: &amp;lt;command&amp;gt; &amp;lt;SRC-id&amp;gt; &amp;lt;description&amp;gt;" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="420" y="1160" width="400" height="44" as="geometry"/></mxCell><mxCell id="p4c16" value="&lt;b&gt;STOP: ask before pushing&lt;/b&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="470" y="1226" width="300" height="54" as="geometry"/></mxCell><mxCell id="p4c17" value="Knowledge updated; delivery impact reported" style="rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="420" y="1302" width="400" height="44" as="geometry"/></mxCell><mxCell id="p4c18" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c3" target="p4c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4c19" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c4" target="p4c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4c20" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c7" target="p4c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4c21" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c8" target="p4c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4c22" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c9" target="p4c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4c23" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c10" target="p4c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4c24" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c13" target="p4c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4c25" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c14" target="p4c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4c26" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c15" target="p4c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4c27" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c16" target="p4c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4c28" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c5" target="p4c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4c29" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c5" target="p4c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4c30" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c11" target="p4c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4c31" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4c11" target="p4c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4c32" value="&lt;b&gt;knowledge/_staging/&amp;lt;date&amp;gt;-&amp;lt;command&amp;gt;-&amp;lt;slug&amp;gt;.md&lt;/b&gt;&lt;br&gt;the working file: items, verdicts, the critic's&lt;br&gt;section and the BA's ticks. Resume with&lt;br&gt;/intake knowledge/_staging/&amp;lt;file&amp;gt;" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1100" y="190" width="440" height="92" as="geometry"/></mxCell><mxCell id="p4c33" value="writes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4c9" target="p4c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4c34" value="&lt;b&gt;Verdicts against the knowledge base&lt;/b&gt;&lt;br&gt;new · confirms &amp;lt;ID&amp;gt; · extends &amp;lt;ID&amp;gt; ·&lt;br&gt;contradicts &amp;lt;ID&amp;gt; · duplicate of &amp;lt;ID&amp;gt; ·&lt;br&gt;answers &amp;lt;Q-ID&amp;gt;" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1100" y="310" width="440" height="92" as="geometry"/></mxCell><mxCell id="p4c35" value="&lt;b&gt;Rules it enforces&lt;/b&gt; (_meta/conventions.md)&lt;br&gt;Confirmed or approved text is never overwritten: a&lt;br&gt;question or a superseding decision instead · no fact&lt;br&gt;without a source · a decision needs authority · names&lt;br&gt;become roles · nothing from inbox/ is committed" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1100" y="430" width="440" height="120" as="geometry"/></mxCell><mxCell id="p4c36" value="&lt;b&gt;Never&lt;/b&gt;&lt;br&gt;write to a page before the BA accepts the item, or&lt;br&gt;write text the BA didn't see" style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1100" y="578" width="440" height="76" as="geometry"/></mxCell><mxCell id="p4c37" value="&lt;i&gt;Legend:&lt;/i&gt; navy = start and end · blue = step · yellow = decision · red hexagon = STOP for you · purple = sub-agent · green = rules · orange = working file · dashed = writes" style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1360" width="1520" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page5" name="5 Requirements and review"><mxGraphModel dx="1640" dy="1240" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1240" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p5c1" value="Requirements and review: write the document, then grade it" style="text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="40" as="geometry"/></mxCell><mxCell id="p5c2" value="Two commands, left then right. &lt;b&gt;/requirements&lt;/b&gt; interviews you and writes requirements/&amp;lt;slug&amp;gt;/requirement.md; new knowledge goes through the pipeline. &lt;b&gt;/review&lt;/b&gt; changes nothing but its report and gives the verdict /backlog relies on." style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1560" height="40" as="geometry"/></mxCell><mxCell id="p5c3" value="/requirements &amp;lt;epic, topic or Jira epic key&amp;gt;" style="rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="400" height="44" as="geometry"/></mxCell><mxCell id="p5c4" value="&lt;b&gt;1 · Current state&lt;/b&gt;&lt;br&gt;search the knowledge base for the area; a cited&lt;br&gt;summary and the open questions; nothing yet →&lt;br&gt;suggest /intake first" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="186" width="400" height="90" as="geometry"/></mxCell><mxCell id="p5c5" value="&lt;b&gt;2 · Clarify&lt;/b&gt;: interviews you&lt;br&gt;rounds of at most five questions, one at a time,&lt;br&gt;with a recommended answer · scope → rules →&lt;br&gt;data → experience · the owner's matters become&lt;br&gt;proposals marked pending Q-x" style="rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="296" width="400" height="120" as="geometry"/></mxCell><mxCell id="p5c6" value="&lt;b&gt;3 and 4 · Write the draft&lt;/b&gt; in the project's words&lt;br&gt;FR · NFR in EARS form · stories with at least two&lt;br&gt;Given/When/Then criteria · assumptions · open&lt;br&gt;questions · conflicts with the knowledge base" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="436" width="400" height="104" as="geometry"/></mxCell><mxCell id="p5c7" value="&lt;b&gt;5 · Pre-check&lt;/b&gt;&lt;br&gt;the critic runs review.md's rule-based checks;&lt;br&gt;mechanical fixes made, the rest shown" style="rounded=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="400" height="76" as="geometry"/></mxCell><mxCell id="p5c8" value="&lt;b&gt;6 · Stage new knowledge&lt;/b&gt;&lt;br&gt;terms, rules, assumptions, questions and&lt;br&gt;proposals: pipeline steps 3 and 4" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="656" width="400" height="76" as="geometry"/></mxCell><mxCell id="p5c9" value="&lt;b&gt;7 · STOP: yes or no to the document;&lt;/b&gt;&lt;br&gt;&lt;b&gt;decide each staged item&lt;/b&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="752" width="400" height="64" as="geometry"/></mxCell><mxCell id="p5c10" value="&lt;b&gt;8 · Apply and commit once&lt;/b&gt;&lt;br&gt;real IDs into the document · req: draft &amp;lt;slug&amp;gt;&lt;br&gt;· ask before pushing" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="400" height="76" as="geometry"/></mxCell><mxCell id="p5c11" value="Next: /review" style="rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="400" height="44" as="geometry"/></mxCell><mxCell id="p5c12" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c3" target="p5c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5c13" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c4" target="p5c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5c14" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c5" target="p5c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5c15" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c6" target="p5c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5c16" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c7" target="p5c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5c17" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c8" target="p5c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5c18" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c9" target="p5c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5c19" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c10" target="p5c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5c20" value="/review requirements/&amp;lt;slug&amp;gt;/requirement.md" style="rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="560" y="120" width="400" height="44" as="geometry"/></mxCell><mxCell id="p5c21" value="&lt;b&gt;Rule-based checks&lt;/b&gt;&lt;br&gt;story form · two criteria · failure paths · one testable&lt;br&gt;statement per FR · NFRs in EARS · vague words ·&lt;br&gt;IDs · fix version · cited IDs exist · FR status" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="560" y="186" width="400" height="90" as="geometry"/></mxCell><mxCell id="p5c22" value="&lt;b&gt;Judgement checks&lt;/b&gt;&lt;br&gt;contradictions · glossary use · INVEST · missing&lt;br&gt;paths · likely Jira duplicates · UI steps in criteria" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="560" y="296" width="400" height="76" as="geometry"/></mxCell><mxCell id="p5c23" value="&lt;b&gt;Critical or major&lt;/b&gt;&lt;br&gt;&lt;b&gt;findings?&lt;/b&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="660" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="p5c24" value="&lt;b&gt;Verdict: ready&lt;/b&gt;&lt;br&gt;every story not blocked&lt;br&gt;meets the definition of ready" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="560" y="520" width="190" height="76" as="geometry"/></mxCell><mxCell id="p5c25" value="&lt;b&gt;Verdict: not ready&lt;/b&gt;&lt;br&gt;lists the stories that are&lt;br&gt;ready and the blocked ones" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="770" y="520" width="190" height="76" as="geometry"/></mxCell><mxCell id="p5c26" value="&lt;b&gt;Write review.md&lt;/b&gt;&lt;br&gt;findings with ID, severity, where and fix ·&lt;br&gt;req: review &amp;lt;slug&amp;gt; &amp;lt;verdict&amp;gt; · ask before pushing" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="560" y="620" width="400" height="76" as="geometry"/></mxCell><mxCell id="p5c27" value="&lt;b&gt;STOP: set the document to confirmed?&lt;/b&gt;&lt;br&gt;(ready, or findings accepted, still draft)" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="560" y="716" width="400" height="64" as="geometry"/></mxCell><mxCell id="p5c28" value="&lt;b&gt;Offer fixes&lt;/b&gt;&lt;br&gt;wording as a diff after a yes, then review again;&lt;br&gt;new knowledge through /requirements or /intake" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="560" y="800" width="400" height="76" as="geometry"/></mxCell><mxCell id="p5c29" value="Next: /backlog (ready stories)" style="rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="560" y="940" width="400" height="44" as="geometry"/></mxCell><mxCell id="p5c30" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c20" target="p5c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5c31" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c21" target="p5c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5c32" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c22" target="p5c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5c33" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c26" target="p5c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5c34" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c27" target="p5c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5c35" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5c28" target="p5c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5c36" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.25;exitY=0.85;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5c23" target="p5c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5c37" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.75;exitY=0.85;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5c23" target="p5c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5c38" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5c24" target="p5c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5c39" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5c25" target="p5c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p5c40" value="next" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5c11" target="p5c20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="962"/><mxPoint x="500" y="100"/><mxPoint x="760" y="100"/></Array></mxGeometry></mxCell><mxCell id="p5c41" value="&lt;b&gt;Who decides&lt;/b&gt;&lt;br&gt;Scope, the story split and the fix version are the&lt;br&gt;BA's. Product behaviour (rules, permissions, what&lt;br&gt;the product shows) belongs to whoever stakeholders.md&lt;br&gt;says can decide it; the BA's answer is then a&lt;br&gt;proposal. The owner's sign-off answers them all." style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1100" y="186" width="500" height="120" as="geometry"/></mxCell><mxCell id="p5c42" value="&lt;b&gt;What blocks&lt;/b&gt;&lt;br&gt;A criterion with an open question against it, a story&lt;br&gt;whose remaining criteria fail the definition of ready,&lt;br&gt;or an FR still pending after the sign-off." style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1100" y="326" width="500" height="90" as="geometry"/></mxCell><mxCell id="p5c43" value="&lt;b&gt;requirements/&amp;lt;slug&amp;gt;/requirement.md&lt;/b&gt;&lt;br&gt;REQ-&amp;lt;slug&amp;gt;: draft → confirmed → approved" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1100" y="436" width="500" height="44" as="geometry"/></mxCell><mxCell id="p5c44" value="&lt;b&gt;knowledge/_staging/&amp;lt;date&amp;gt;-requirements-&amp;lt;slug&amp;gt;.md&lt;/b&gt;&lt;br&gt;new terms, rules, assumptions and questions" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1100" y="496" width="500" height="44" as="geometry"/></mxCell><mxCell id="p5c45" value="&lt;b&gt;requirements/&amp;lt;slug&amp;gt;/review.md&lt;/b&gt;&lt;br&gt;REVIEW-&amp;lt;slug&amp;gt;: verdict ready or not-ready, reviewed_on" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1100" y="556" width="500" height="44" as="geometry"/></mxCell><mxCell id="p5c46" value="&lt;b&gt;Never&lt;/b&gt;&lt;br&gt;/review changes the document or a Jira issue unless the&lt;br&gt;BA asks. A No to the document deletes only the draft&lt;br&gt;this run created; staged items can still be applied." style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1100" y="620" width="500" height="90" as="geometry"/></mxCell><mxCell id="p5c47" value="&lt;i&gt;Legend:&lt;/i&gt; navy = start and end · blue = step · yellow = interviews you, or a decision · purple = sub-agent · red hexagon = STOP for you · green = rule · orange = file · dashed = next command" style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="1560" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page6" name="6 Backlog"><mxGraphModel dx="1640" dy="1180" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1180" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p6c1" value="Backlog: put approved work into Jira" style="text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="40" as="geometry"/></mxCell><mxCell id="p6c2" value="Left: a reviewed requirement becomes an epic and stories. Right: a single task, spike or UAT bug. Nothing is created before a &lt;b&gt;preview and your explicit yes&lt;/b&gt;, and your assistant still asks before each Jira write." style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1560" height="40" as="geometry"/></mxCell><mxCell id="p6c3" value="/backlog requirements/&amp;lt;slug&amp;gt;/requirement.md" style="rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="420" height="44" as="geometry"/></mxCell><mxCell id="p6c4" value="&lt;b&gt;1 · Check readiness&lt;/b&gt;&lt;br&gt;review.md newer than the document · status confirmed&lt;br&gt;or approved · review.md decides which stories can go ·&lt;br&gt;blocked stories wait · then the Jira site is checked" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="186" width="420" height="90" as="geometry"/></mxCell><mxCell id="p6c5" value="&lt;b&gt;Ready?&lt;/b&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="160" y="296" width="180" height="80" as="geometry"/></mxCell><mxCell id="p6c6" value="&lt;b&gt;STOP: say what to run&lt;/b&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="520" y="306" width="260" height="60" as="geometry"/></mxCell><mxCell id="p6c7" value="&lt;b&gt;2 · Build the issues&lt;/b&gt;&lt;br&gt;the epic and one story per ST- from templates/jira/ ·&lt;br&gt;existing keys compared section by section · labels,&lt;br&gt;fix version, required fields; never points or assignee" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="420" height="90" as="geometry"/></mxCell><mxCell id="p6c8" value="&lt;b&gt;3 · Search for duplicates&lt;/b&gt;&lt;br&gt;each new issue in the profile's projects:&lt;br&gt;link · update instead · create anyway" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="420" height="76" as="geometry"/></mxCell><mxCell id="p6c9" value="&lt;b&gt;4 · STOP: preview table; an explicit yes&lt;/b&gt;&lt;br&gt;&lt;b&gt;per batch&lt;/b&gt; (at most max_batch, default 15)" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="606" width="420" height="70" as="geometry"/></mxCell><mxCell id="p6c10" value="&lt;b&gt;5 · Create&lt;/b&gt;&lt;br&gt;the epic first, then each story · your assistant asks&lt;br&gt;before each write · each issue read back; fields that&lt;br&gt;didn't stick are reported and offered as a fix" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="696" width="420" height="90" as="geometry"/></mxCell><mxCell id="p6c11" value="&lt;b&gt;6 · Write the keys back&lt;/b&gt;&lt;br&gt;jira_epic and the story table · trace/map.csv rows" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="806" width="420" height="60" as="geometry"/></mxCell><mxCell id="p6c12" value="&lt;b&gt;7 · Log and commit&lt;/b&gt;&lt;br&gt;req: backlog &amp;lt;slug&amp;gt; &amp;lt;epic key&amp;gt; · ask before pushing" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="886" width="420" height="60" as="geometry"/></mxCell><mxCell id="p6c13" value="Delivery takes the Jira keys" style="rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="420" height="44" as="geometry"/></mxCell><mxCell id="p6c14" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c3" target="p6c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6c15" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c4" target="p6c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6c16" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c7" target="p6c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6c17" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c8" target="p6c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6c18" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c9" target="p6c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6c19" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c10" target="p6c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6c20" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c11" target="p6c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6c21" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c12" target="p6c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6c22" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c5" target="p6c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6c23" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c5" target="p6c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6c24" value="/backlog task ACT-&amp;lt;n&amp;gt; · spike Q-&amp;lt;n&amp;gt; · bug &amp;lt;SRC-id&amp;gt; &amp;lt;item&amp;gt;" style="rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="840" y="186" width="360" height="54" as="geometry"/></mxCell><mxCell id="p6c25" value="&lt;b&gt;1 · Read what it comes from&lt;/b&gt;&lt;br&gt;the ACT- row in raid.md, the Q- page, or the UAT&lt;br&gt;item in its source record; stop if not open" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="840" y="262" width="360" height="76" as="geometry"/></mxCell><mxCell id="p6c26" value="&lt;b&gt;2 · Build it&lt;/b&gt;&lt;br&gt;from task.md, spike.md or bug.md; asks&lt;br&gt;for what the source doesn't give" style="rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="840" y="358" width="360" height="76" as="geometry"/></mxCell><mxCell id="p6c27" value="&lt;b&gt;3 · Search for duplicates&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="840" y="454" width="360" height="44" as="geometry"/></mxCell><mxCell id="p6c28" value="&lt;b&gt;4 · STOP: preview the one issue&lt;/b&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="840" y="518" width="360" height="54" as="geometry"/></mxCell><mxCell id="p6c29" value="&lt;b&gt;Create, read back, write the key back&lt;/b&gt;&lt;br&gt;to the ACT- row, the question or the&lt;br&gt;source record · log line · commit" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="840" y="592" width="360" height="76" as="geometry"/></mxCell><mxCell id="p6c30" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c24" target="p6c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6c31" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c25" target="p6c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6c32" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c26" target="p6c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6c33" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c27" target="p6c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6c34" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6c28" target="p6c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6c35" value="&lt;b&gt;Never&lt;/b&gt;&lt;br&gt;create anything before the batch is&lt;br&gt;approved, or more than max_batch at once ·&lt;br&gt;set story points, assignee, or a priority&lt;br&gt;the requirement doesn't state · transition&lt;br&gt;or delete existing issues" style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1240" y="186" width="360" height="120" as="geometry"/></mxCell><mxCell id="p6c36" value="&lt;b&gt;Issues no longer in the document&lt;/b&gt;&lt;br&gt;are listed for the BA to close or&lt;br&gt;rescope in Jira by hand; their trace&lt;br&gt;rows go once the BA confirms." style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1240" y="326" width="360" height="90" as="geometry"/></mxCell><mxCell id="p6c37" value="&lt;b&gt;trace/map.csv&lt;/b&gt;&lt;br&gt;fr_ids · story_id · jira_key ·&lt;br&gt;knowledge_pages · requirement_doc" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1240" y="436" width="360" height="60" as="geometry"/></mxCell><mxCell id="p6c38" value="&lt;i&gt;Legend:&lt;/i&gt; navy = start and end · blue = step · yellow = asks you, or a decision · red hexagon = STOP for you · red = never · green = rule · orange = file" style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1060" width="1560" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page7" name="7 Ask"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p7c1" value="Ask: answers from the knowledge base, with citations" style="text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="40" as="geometry"/></mxCell><mxCell id="p7c2" value="Anyone who clones the BA repository can ask. &lt;b&gt;/ask&lt;/b&gt; reads only, cites every claim, labels how sure each part is, and says plainly when the knowledge base doesn't know." style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1520" height="40" as="geometry"/></mxCell><mxCell id="p7c3" value="/ask &amp;lt;question&amp;gt; (anyone)" style="rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="420" height="44" as="geometry"/></mxCell><mxCell id="p7c4" value="&lt;b&gt;1 · Find&lt;/b&gt;&lt;br&gt;knowledge/index.md · synonyms from the glossary&lt;br&gt;and page aliases · search knowledge/ and&lt;br&gt;requirements/ · follow links one level" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="186" width="420" height="90" as="geometry"/></mxCell><mxCell id="p7c5" value="&lt;b&gt;Settled by the&lt;/b&gt;&lt;br&gt;&lt;b&gt;knowledge base?&lt;/b&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="150" y="296" width="200" height="100" as="geometry"/></mxCell><mxCell id="p7c6" value="&lt;b&gt;2 · Jira and Confluence&lt;/b&gt;&lt;br&gt;only when connected; search within the&lt;br&gt;profile's projects and spaces; labelled&lt;br&gt;&quot;from Jira&quot; or &quot;from Confluence&quot;" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="520" y="300" width="360" height="90" as="geometry"/></mxCell><mxCell id="p7c7" value="&lt;b&gt;3 · Answer&lt;/b&gt;&lt;br&gt;the direct answer first · each claim cites the page&lt;br&gt;and ID that defines it · status labels · open&lt;br&gt;questions that bear on it, with who and when" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="420" height="90" as="geometry"/></mxCell><mxCell id="p7c8" value="&lt;b&gt;4 · Check claim by claim&lt;/b&gt;&lt;br&gt;the cited sentence supports it · labels match the&lt;br&gt;page's status · no superseded page · nothing&lt;br&gt;from general knowledge" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="420" height="90" as="geometry"/></mxCell><mxCell id="p7c9" value="&lt;b&gt;Anything the&lt;/b&gt;&lt;br&gt;&lt;b&gt;knowledge base&lt;/b&gt;&lt;br&gt;&lt;b&gt;doesn't know?&lt;/b&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="140" y="640" width="220" height="110" as="geometry"/></mxCell><mxCell id="p7c10" value="&lt;b&gt;5 · &quot;The knowledge base doesn't answer this&quot;&lt;/b&gt;&lt;br&gt;point to the open Q- that asks it, or draft a&lt;br&gt;question for the BA: what, why, who might know" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="520" y="655" width="400" height="80" as="geometry"/></mxCell><mxCell id="p7c11" value="Cited answer" style="rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="420" height="44" as="geometry"/></mxCell><mxCell id="p7c12" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p7c3" target="p7c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7c13" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p7c4" target="p7c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7c14" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p7c7" target="p7c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7c15" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p7c8" target="p7c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7c16" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p7c5" target="p7c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7c17" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p7c5" target="p7c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7c18" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7c6" target="p7c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7c19" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p7c9" target="p7c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7c20" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p7c9" target="p7c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7c21" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7c10" target="p7c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7c22" value='&lt;b&gt;How sure each part is&lt;/b&gt;&lt;br&gt;confirmed or approved: stated plainly · draft:&lt;br&gt;"(unconfirmed: draft page)" · superseded: never&lt;br&gt;used · an open question by its state, asked_of&lt;br&gt;and due · staging files: "waiting for the BA"' style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="980" y="186" width="560" height="106" as="geometry"/></mxCell><mxCell id="p7c23" value="&lt;b&gt;Read-only in every assistant&lt;/b&gt;&lt;br&gt;Claude Code: /ask disallows file writes, shell, sub-agents&lt;br&gt;and every Atlassian write tool · OpenCode: runs as the&lt;br&gt;kb-reader agent · Codex and others: the definition and&lt;br&gt;AGENTS.md" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="980" y="312" width="560" height="106" as="geometry"/></mxCell><mxCell id="p7c24" value="&lt;b&gt;Never&lt;/b&gt;&lt;br&gt;read inbox/ · answer from general knowledge or&lt;br&gt;guess what the product does · change anything; a&lt;br&gt;correction is drafted for the BA instead" style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="980" y="438" width="560" height="90" as="geometry"/></mxCell><mxCell id="p7c25" value="&lt;i&gt;Legend:&lt;/i&gt; navy = start and end · blue = step · yellow = decision · grey = outside the harness · green = rule · red = never" style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="1520" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page8" name="8 Safety layers"><mxGraphModel dx="1660" dy="1280" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1280" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p8c1" value="Safety layers: what each assistant asks about or refuses" style="text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="40" as="geometry"/></mxCell><mxCell id="p8c2" value="One row per protection, one column per assistant. Each assistant enforces the same rules through its own settings: &lt;b&gt;.claude/settings.json&lt;/b&gt;, &lt;b&gt;opencode.json&lt;/b&gt;, or &lt;b&gt;.codex/&lt;/b&gt; (config.toml, rules, hooks.json). The command definitions add the steps on top." style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1580" height="40" as="geometry"/></mxCell><mxCell id="p8c3" value="Protection" style="text;fontSize=14;fontStyle=1;fontColor=#333333;align=center;verticalAlign=middle;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="320" height="36" as="geometry"/></mxCell><mxCell id="p8c4" value="Claude Code" style="text;fontSize=14;fontStyle=1;fontColor=#333333;align=center;verticalAlign=middle;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="380" y="110" width="400" height="36" as="geometry"/></mxCell><mxCell id="p8c5" value="OpenCode" style="text;fontSize=14;fontStyle=1;fontColor=#333333;align=center;verticalAlign=middle;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="110" width="400" height="36" as="geometry"/></mxCell><mxCell id="p8c6" value="Codex" style="text;fontSize=14;fontStyle=1;fontColor=#333333;align=center;verticalAlign=middle;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1220" y="110" width="400" height="36" as="geometry"/></mxCell><mxCell id="p8c7" value="&lt;b&gt;Jira and Confluence writes&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="320" height="70" as="geometry"/></mxCell><mxCell id="p8c8" value="&lt;b&gt;ASK&lt;/b&gt; before each write tool, matched by&lt;br&gt;verb (create*, edit*, update* …)" style="rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="380" y="160" width="400" height="70" as="geometry"/></mxCell><mxCell id="p8c9" value="&lt;b&gt;ASK&lt;/b&gt; for every Atlassian tool that&lt;br&gt;isn't on the list of reads" style="rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="160" width="400" height="70" as="geometry"/></mxCell><mxCell id="p8c10" value="&lt;b&gt;ASK&lt;/b&gt; for every tool not marked&lt;br&gt;read-only; executeWrite always asks" style="rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1220" y="160" width="400" height="70" as="geometry"/></mxCell><mxCell id="p8c11" value="&lt;b&gt;Jira and Confluence deletes&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="248" width="320" height="70" as="geometry"/></mxCell><mxCell id="p8c12" value="&lt;b&gt;REFUSE&lt;/b&gt; delete* tools and&lt;br&gt;executeDestructive" style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="380" y="248" width="400" height="70" as="geometry"/></mxCell><mxCell id="p8c13" value="&lt;b&gt;REFUSE&lt;/b&gt; atlassian_delete* and&lt;br&gt;executeDestructive" style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="248" width="400" height="70" as="geometry"/></mxCell><mxCell id="p8c14" value="&lt;b&gt;REFUSE&lt;/b&gt;: executeDestructive is&lt;br&gt;switched off" style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1220" y="248" width="400" height="70" as="geometry"/></mxCell><mxCell id="p8c15" value="&lt;b&gt;git push&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="336" width="320" height="70" as="geometry"/></mxCell><mxCell id="p8c16" value="&lt;b&gt;ASK&lt;/b&gt; every time" style="rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="380" y="336" width="400" height="70" as="geometry"/></mxCell><mxCell id="p8c17" value="&lt;b&gt;ASK&lt;/b&gt; every time" style="rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="336" width="400" height="70" as="geometry"/></mxCell><mxCell id="p8c18" value="&lt;b&gt;ASK&lt;/b&gt; every time (rules file)" style="rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1220" y="336" width="400" height="70" as="geometry"/></mxCell><mxCell id="p8c19" value="&lt;b&gt;Force push, hard reset, git clean,&lt;br&gt;branch -D, filter-branch&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="424" width="320" height="70" as="geometry"/></mxCell><mxCell id="p8c20" value="&lt;b&gt;REFUSE&lt;/b&gt; (Bash and PowerShell)" style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="380" y="424" width="400" height="70" as="geometry"/></mxCell><mxCell id="p8c21" value="&lt;b&gt;REFUSE&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="424" width="400" height="70" as="geometry"/></mxCell><mxCell id="p8c22" value="&lt;b&gt;REFUSE&lt;/b&gt; when the command starts&lt;br&gt;that way" style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1220" y="424" width="400" height="70" as="geometry"/></mxCell><mxCell id="p8c23" value="&lt;b&gt;Recursive deletes&lt;br&gt;(rm -r, Remove-Item -Recurse, rmdir)&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="512" width="320" height="70" as="geometry"/></mxCell><mxCell id="p8c24" value="&lt;b&gt;REFUSE&lt;/b&gt; (Bash and PowerShell)" style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="380" y="512" width="400" height="70" as="geometry"/></mxCell><mxCell id="p8c25" value="&lt;b&gt;REFUSE&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="512" width="400" height="70" as="geometry"/></mxCell><mxCell id="p8c26" value="&lt;b&gt;REFUSE&lt;/b&gt; rm -r and rmdir;&lt;br&gt;Remove-Item asks" style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1220" y="512" width="400" height="70" as="geometry"/></mxCell><mxCell id="p8c27" value="&lt;b&gt;A delete naming a path outside&lt;br&gt;the repository&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="320" height="70" as="geometry"/></mxCell><mxCell id="p8c28" value="&lt;b&gt;ASK&lt;/b&gt;: a drive letter, absolute path,&lt;br&gt;home folder, variable or .." style="rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="380" y="600" width="400" height="70" as="geometry"/></mxCell><mxCell id="p8c29" value="&lt;b&gt;ASK&lt;/b&gt;, and external_directory asks&lt;br&gt;before any outside folder" style="rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="600" width="400" height="70" as="geometry"/></mxCell><mxCell id="p8c30" value="&lt;b&gt;SANDBOX&lt;/b&gt;: workspace-write keeps&lt;br&gt;commands inside the repository" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1220" y="600" width="400" height="70" as="geometry"/></mxCell><mxCell id="p8c31" value="&lt;b&gt;Edits to the harness's own files&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="688" width="320" height="70" as="geometry"/></mxCell><mxCell id="p8c32" value="&lt;b&gt;ASK&lt;/b&gt; for anything under .claude/" style="rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="380" y="688" width="400" height="70" as="geometry"/></mxCell><mxCell id="p8c33" value="&lt;b&gt;ASK&lt;/b&gt; for .opencode, .claude, .codex,&lt;br&gt;.agents, opencode.json, .mcp.json" style="rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="688" width="400" height="70" as="geometry"/></mxCell><mxCell id="p8c34" value="&lt;b&gt;SANDBOX&lt;/b&gt;, plus the definitions'&lt;br&gt;own rules" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1220" y="688" width="400" height="70" as="geometry"/></mxCell><mxCell id="p8c35" value="&lt;b&gt;/ask stays read-only&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="776" width="320" height="70" as="geometry"/></mxCell><mxCell id="p8c36" value="&lt;b&gt;REFUSE&lt;/b&gt; writes, shell, sub-agents and&lt;br&gt;Atlassian writes (disallowed-tools)" style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="380" y="776" width="400" height="70" as="geometry"/></mxCell><mxCell id="p8c37" value="&lt;b&gt;REFUSE&lt;/b&gt;: runs as kb-reader, with no&lt;br&gt;edit, shell or Jira write tools" style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="776" width="400" height="70" as="geometry"/></mxCell><mxCell id="p8c38" value="&lt;b&gt;RULE&lt;/b&gt;: the definition; ask may start&lt;br&gt;on its own, the others only when named" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1220" y="776" width="400" height="70" as="geometry"/></mxCell><mxCell id="p8c39" value="&lt;b&gt;Knowledge base sync&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="864" width="320" height="70" as="geometry"/></mxCell><mxCell id="p8c40" value="&lt;b&gt;CONTEXT&lt;/b&gt;: SessionStart hook runs&lt;br&gt;tools/kb-sync.sh" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="380" y="864" width="400" height="70" as="geometry"/></mxCell><mxCell id="p8c41" value="&lt;b&gt;CONTEXT&lt;/b&gt;: each command runs&lt;br&gt;tools/kb-sync.sh first" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="800" y="864" width="400" height="70" as="geometry"/></mxCell><mxCell id="p8c42" value="&lt;b&gt;CONTEXT&lt;/b&gt;: SessionStart hook, once&lt;br&gt;you trust it with /hooks" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1220" y="864" width="400" height="70" as="geometry"/></mxCell><mxCell id="p8c43" value="&lt;b&gt;Safety beyond the settings&lt;/b&gt;&lt;br&gt;Every Jira batch needs a preview and an explicit yes · every knowledge item needs the BA's accept · inbox/ is gitignored and&lt;br&gt;intake proposes redactions · AGENTS.md and CLAUDE.md forbid deleting or moving anything outside inbox/ and knowledge/_staging/ ·&lt;br&gt;tools/kb.py check and the GitHub check catch broken links, bad IDs and stale registers · Codex applies .codex/ only to a trusted project" style="rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="1580" height="104" as="geometry"/></mxCell><mxCell id="p8c44" value="&lt;b&gt;To change a protection&lt;/b&gt;, use /improve-harness: a change to a permission or approval step is never applied in a project; it goes to the&lt;br&gt;harness maintainers as a proposal, so every project gets it at once." style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="1084" width="1580" height="64" as="geometry"/></mxCell><mxCell id="p8c45" value="&lt;i&gt;Legend:&lt;/i&gt; red = REFUSE · yellow = ASK, or a step you confirm · blue = SANDBOX or CONTEXT · green = rule · grey = protection" style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1180" width="1580" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page9" name="9 Changing the harness"><mxGraphModel dx="1600" dy="1240" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1240" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p9c1" value="Changing the harness: /improve-harness" style="text;fontSize=22;fontStyle=1;fontColor=#1f4e79;align=left;verticalAlign=middle;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="40" as="geometry"/></mxCell><mxCell id="p9c2" value="When a command, template or rule should work differently. It finds out what is wrong, decides where the fix belongs, and records it, so the harness can learn. &lt;b&gt;Safety changes are never applied in a project.&lt;/b&gt;" style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1520" height="40" as="geometry"/></mxCell><mxCell id="p9c3" value="/improve-harness &amp;lt;what isn't working&amp;gt;" style="rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="420" y="120" width="400" height="44" as="geometry"/></mxCell><mxCell id="p9c4" value="&lt;b&gt;1 · Understand it&lt;/b&gt;&lt;br&gt;at most three questions, one at a time: which&lt;br&gt;command, what should have happened, an example" style="rounded=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="420" y="186" width="400" height="76" as="geometry"/></mxCell><mxCell id="p9c5" value="&lt;b&gt;2 · Where does&lt;/b&gt;&lt;br&gt;&lt;b&gt;it belong?&lt;/b&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="520" y="284" width="200" height="100" as="geometry"/></mxCell><mxCell id="p9c6" value="&lt;b&gt;Knowledge&lt;/b&gt;&lt;br&gt;not here: run /intake" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="304" width="300" height="60" as="geometry"/></mxCell><mxCell id="p9c7" value="&lt;b&gt;A project setting&lt;/b&gt;&lt;br&gt;PROJECT-PROFILE.md diff → yes → log line&lt;br&gt;→ kb: profile &amp;lt;what&amp;gt; → ask before pushing" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="900" y="296" width="380" height="76" as="geometry"/></mxCell><mxCell id="p9c8" value="&lt;b&gt;3 · Draft the change&lt;/b&gt;&lt;br&gt;the exact diff (git apply --check) · checked against&lt;br&gt;other commands, the conventions, the handbook" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="420" y="410" width="400" height="76" as="geometry"/></mxCell><mxCell id="p9c9" value="&lt;b&gt;4 · Judge the risk&lt;/b&gt;&lt;br&gt;safety · behaviour · wording; the version impact" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="420" y="506" width="400" height="60" as="geometry"/></mxCell><mxCell id="p9c10" value="&lt;b&gt;5 · Write the proposal&lt;/b&gt;&lt;br&gt;harness-feedback/&amp;lt;date&amp;gt;-&amp;lt;slug&amp;gt;.md, status proposed" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="420" y="586" width="400" height="60" as="geometry"/></mxCell><mxCell id="p9c11" value="&lt;b&gt;Maintainer, not a&lt;/b&gt;&lt;br&gt;&lt;b&gt;safety change, and&lt;/b&gt;&lt;br&gt;&lt;b&gt;the BA says yes?&lt;/b&gt;" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="510" y="668" width="220" height="120" as="geometry"/></mxCell><mxCell id="p9c12" value="&lt;b&gt;6 · Apply it here too&lt;/b&gt;&lt;br&gt;the exact diff · a row in profile section 8 ·&lt;br&gt;status applied-locally" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="900" y="690" width="380" height="76" as="geometry"/></mxCell><mxCell id="p9c13" value="&lt;b&gt;Waits for the maintainers&lt;/b&gt;" style="rounded=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="698" width="300" height="60" as="geometry"/></mxCell><mxCell id="p9c14" value="&lt;b&gt;7 · Log and commit&lt;/b&gt;&lt;br&gt;harness: &amp;lt;proposed|local&amp;gt; &amp;lt;slug&amp;gt;" style="rounded=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="420" y="820" width="400" height="60" as="geometry"/></mxCell><mxCell id="p9c15" value="&lt;b&gt;STOP: ask before pushing&lt;/b&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.06;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="470" y="902" width="300" height="54" as="geometry"/></mxCell><mxCell id="p9c16" value="Send the proposal to the harness maintainers" style="rounded=1;arcSize=50;fillColor=#1f4e79;strokeColor=#1f4e79;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="420" y="980" width="400" height="44" as="geometry"/></mxCell><mxCell id="p9c17" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p9c3" target="p9c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p9c18" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p9c4" target="p9c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p9c19" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p9c8" target="p9c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p9c20" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p9c9" target="p9c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p9c21" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p9c10" target="p9c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p9c22" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p9c14" target="p9c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p9c23" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p9c15" target="p9c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p9c24" value="knowledge" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p9c5" target="p9c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p9c25" value="setting" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p9c5" target="p9c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p9c26" value="harness" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p9c5" target="p9c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p9c27" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p9c11" target="p9c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p9c28" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p9c11" target="p9c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p9c29" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p9c12" target="p9c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p9c30" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#555555;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p9c13" target="p9c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p9c31" value="&lt;b&gt;Safety changes go to the maintainers only&lt;/b&gt;&lt;br&gt;.claude/settings.json · a wrapper's allowed-tools or&lt;br&gt;disallowed-tools · a Never rule · a preview or approval&lt;br&gt;step · redaction · when Jira or Confluence is written" style="rounded=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="900" y="410" width="380" height="106" as="geometry"/></mxCell><mxCell id="p9c32" value="&lt;b&gt;harness-feedback/&amp;lt;date&amp;gt;-&amp;lt;slug&amp;gt;.md&lt;/b&gt;&lt;br&gt;problem, evidence, kind and risk, diff, files,&lt;br&gt;status: proposed → applied-locally → accepted" style="shape=note;backgroundOutline=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="900" y="540" width="380" height="76" as="geometry"/></mxCell><mxCell id="p9c33" value="&lt;b&gt;/improve-harness list&lt;/b&gt;&lt;br&gt;the proposals and their status; local changes a&lt;br&gt;harness update could undo (profile section 8)" style="rounded=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontFamily=Helvetica;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="900" y="960" width="380" height="76" as="geometry"/></mxCell><mxCell id="p9c34" value="&lt;i&gt;Legend:&lt;/i&gt; navy = start and end · yellow = asks you, or a decision · blue = step · red hexagon = STOP · red = safety rule · grey = outside the harness · green = related command · orange = file" style="text;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1060" width="1520" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
